generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SupplementType {
  SEJOUR
  HEBDOMADAIRE
  QUOTIDIEN
}

enum TarifFrequence {
  SEMAINE
  JOUR
  WEEKEND
  PERSONNE
}

enum EventType {
  RANDO
  VISIT
  EVENT
}

enum ReservationStatut {
  DEMANDE
  OPTION
  CONFIRMEE
  REFUSEE
  ANNULEE
}

enum ReservationSource {
  SITE
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Client {
  id        Int    @id @default(autoincrement())
  nom       String
  prenom    String
  email     String
  telephone String

  reservations Reservation[]
}

model Reservation {
  id        Int      @id @default(autoincrement())
  tarif     Float?
  debut     DateTime @db.Date
  fin       DateTime @db.Date
  dateAjout DateTime @default(now())

  adultes Int @default(0)
  enfants Int @default(0)
  animaux Int @default(0)

  statut          ReservationStatut @default(DEMANDE)
  statutModifieLe DateTime          @default(now())
  source          ReservationSource @default(ADMIN)

  demandeurNom       String?
  demandeurEmail     String?
  demandeurTelephone String?
  message            String?

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId Int?

  supplements SupplementOnReservation[]

  @@index([statut, fin])
  @@index([debut, fin])
  @@index([clientId])
}

model Supplement {
  id        Int            @id @default(autoincrement())
  label     String         @unique @default("")
  tarif     Float
  type      SupplementType
  /// Supplément facturé par animal : ajouté automatiquement aux demandes du site qui indiquent des animaux.
  /// Un seul supplément l'est à la fois.
  parAnimal Boolean        @default(false)

  reservations SupplementOnReservation[]
}

model SupplementOnReservation {
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reservationId Int
  supplement    Supplement  @relation(fields: [supplementId], references: [id])
  supplementId  Int
  nb            Int
  tarif         Float

  @@id([reservationId, supplementId])
  @@index([supplementId])
}

model Commentaire {
  id          Int      @id @default(autoincrement())
  verif       Boolean  @default(false)
  created     DateTime @default(now()) @db.Date
  commentaire String
  name        String
  note        Int
}

model Tarif {
  id        Int              @id @default(autoincrement())
  desc      String
  label     String           @unique
  date      String[]
  vacance   Boolean          @default(false)
  prix      Float
  frequence TarifFrequence[]
}

model Evenement {
  id           Int       @id @default(autoincrement())
  titre        String
  image        String
  date         DateTime?
  type         EventType
  localisation String?
  description  String
  lien         String?
}
